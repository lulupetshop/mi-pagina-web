# =====================================================================
# NOVA Tech — Configuración para Hostinger (Apache / LiteSpeed)
# =====================================================================

Options -Indexes
DirectoryIndex index.html

# --- Nunca servir el config con el Access Token ni el log de pedidos ---
<FilesMatch "^(config\.php|orders\.log)$">
  Require all denied
</FilesMatch>

# --- Tipos de archivo ---
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddDefaultCharset UTF-8
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Caché ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
